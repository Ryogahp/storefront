# Cloudinary — serve product images from the Cloudinary CDN.
# Load these in Netlify (Site settings → Environment variables) or in a local .env.
# Optional: when unset, images fall back to the local files in public/assets/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Checkout (Stripe). Required only for the checkout flow to work at runtime.
STRIPE_SECRET_KEY=
US_SHIPPING_RATE_ID=
INTERNATIONAL_SHIPPING_RATE_ID=

# Emails (Loops.so) — optional.
LOOPS_API_KEY=
LOOPS_SHOP_TRANSACTIONAL_ID=
LOOPS_FULFILLMENT_TRANSACTIONAL_ID=
LOOPS_FULFILLMENT_EMAIL=

# Google Maps — optional, used to render the shipping map on the order page.
GOOGLE_GEOLOCATION_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
