---
import { cldImageUrl } from '~/lib/cloudinary.server';
import { button } from '~/styles.ts';
import Card from '~/components/ui/Card.tsx';

export interface Props {
	name: string;
	slug: string;
	imageUrl?: string;
	cta?: string;
}

const imageUrl = Astro.props.imageUrl && cldImageUrl(Astro.props.imageUrl, 390, 390);
---

<Card>
	<a href={`/collections/${Astro.props.slug}`} class="w-full">
		<article class="flex flex-col items-start gap-3 p-6">
			{
				imageUrl && (
					<img
						src={imageUrl}
						alt=""
						class="aspect-square self-center"
						loading="lazy"
						width="390"
						height="390"
					/>
				)
			}
			<p class="text-pretty text-3xl font-semibold">
				{Astro.props.name}
			</p>
			<p class={button()}>
				{Astro.props.cta ?? 'Shop now'}
			</p>
		</article>
	</a>
</Card>
